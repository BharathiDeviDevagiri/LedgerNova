PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ledgerline?schema=public"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

CORS_ORIGIN="http://localhost:5173"

# Optional for local demo seeding only. Use different, randomly generated values.
# The seed script refuses to run in production.
LEDGERLINE_SEED_HOLDER_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
LEDGERLINE_SEED_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_PASSWORD
LEDGERLINE_SEED_AUDITOR_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_PASSWORD