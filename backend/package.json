{
"name": "ledgernova-backend",
  "version": "1.0.0",
"description": "Double-entry banking ledger backend for Snovasys Fresher Hiring Challenge 2026",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test": "node --test",
    "test:unit": "node --test",
    "db:seed": "node prisma/seed.js",
    "test:integration": "node --import ./integration/setup.js --test --test-concurrency=1 ./integration/suite.js ./integration/database-invariants.integration.js",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "keywords": [
    "banking",
    "double-entry",
    "ledger",
    "prisma",
    "express",
    "postgresql"
  ],
"author": "Bharathi Devi"
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
